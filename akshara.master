<%@ Master Language="C#" AutoEventWireup="true" CodeFile="akshara.master.cs" Inherits="preview_dotnet_templates_akshara_multi_master_akshara" %>
<%@ Register TagPrefix="uc" TagName="WorkflowStatus" Src="~/WorkflowStatusPanel.ascx" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "">

<html xmlns="">
<head runat="server">
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>M &amp; E</title>
    <link href="css/bootstrap.min.css" rel="stylesheet">
    <link href="css/jquery.smartmenus.bootstrap.css" rel="stylesheet">
    <link href="css/owl/owl.carousel.css" rel="stylesheet" type="text/css" />
    <link href="css/owl/owl.theme.css" rel="stylesheet" type="text/css" />
    <link href="css/owl/owl.transitions.css" rel="stylesheet" type="text/css" />
    <link href="css/1-col-portfolio.css" rel="stylesheet">
    <link href="css/style.css" rel="stylesheet">
    <link href="css/responsive.css" rel="stylesheet">
    <link href="css/animate.min.css" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="engine1/style.css" />
    <script type="text/javascript" src="engine1/jquery.js"></script>
    <link href="fonts/font-awesome.min.css" rel="stylesheet" type="text/css" />

    <style type="text/css">
        /* Taller navbar to fit larger logo */
        .navbar-inverse.navbar-fixed-top { min-height: 58px; }
        .navbar-inverse .navbar-header { height: 58px; }
        .navbar-inverse .navbar-nav > li > a { padding-top: 19px; padding-bottom: 19px; }
        .navbar-brand { padding-top: 5px; padding-bottom: 5px; height: 58px; }

        /* Navbar brand text */
        .navbar-brand-text {
            display: inline-block;
            vertical-align: middle;
            line-height: 1.2;
            margin-left: 8px;
        }
        .navbar-brand-text strong {
            display: block;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.3px;
            color: #fff;
        }
        .navbar-brand-text small {
            display: block;
            font-size: 10px;
            color: rgba(255,255,255,0.75);
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
        .navbar-brand img.logo {
            vertical-align: middle;
        }
        /* Dropdown section headers */
        .dropdown-menu > .dropdown-header {
            font-size: 10px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #aaa;
            padding: 8px 16px 4px;
        }
        .dropdown-menu {
            min-width: 210px;
        }
        /* User menu item */
        .navbar-nav .user-menu > a {
            padding-top: 12px;
            padding-bottom: 12px;
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server" autocomplete="off">

    <!-- Navbar -->
    <div class="navbar navbar-inverse navbar-fixed-top" role="navigation">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a href="home.aspx" class="navbar-brand">
                    <img id="imgLogo1" runat="server" class="logo" src="img/logo.png" alt="logo" style="height:48px;" />
                    <span class="navbar-brand-text">
                        <strong>Provincial M&amp;E</strong>
                        <small>Office of the Premier</small>
                    </span>
                </a>
            </div>

            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav navbar-right">
                    <li><a href="home.aspx"><i class="glyphicon glyphicon-home"></i> Home</a></li>

                    <%-- Administrator: Planning Unit dropdown --%>
                    <li class="dropdown" id="ddl_PlanningUnit" runat="server" visible="false">
                        <a id="A3" runat="server" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Planning Unit <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li class="dropdown-header">Setup</li>
                            <li><a href="new_PU_ClusterWG.aspx">PU Clusters</a></li>
                            <li><a href="i_PriorityAdmin.aspx">Strategic Priorities</a></li>
                            <li><a href="i_Cluster.aspx">Provincial Clusters</a></li>
                            <li><a href="i_ProgrammeAdmin.aspx">Integration Programmes</a></li>
                            <li><a href="i_ProgrammeInstitutions.aspx">Supporting Institutions</a></li>
                            <li><a href="i_OutcomeAdmin.aspx">Impact (Outcomes)</a></li>
                            <li><a href="i_IndicatorAdmin.aspx">Indicators</a></li>
                            <li><a href="i_AnnualTargets.aspx">Annual Targets</a></li>
                            <li><a href="i_SystemPeriodsAdmin.aspx">System Periods</a></li>
                            <li role="separator" class="divider"></li>
                            <li class="dropdown-header">PMTDP / POA</li>
                            <li><a href="i_PMTDPUpload.aspx">PMTDP Upload</a></li>
                            <li><a href="i_PMTDPPriorityList.aspx">Assign Clusters</a></li>
                            <li><a href="j_PMTDPApprovalList.aspx">Approval List</a></li>
                            <li><a href="j_PMTDPApprovalView.aspx">Approval View</a></li>
                            <li><a href="pageAddPOA.aspx">Create POA</a></li>
                            <li><a href="i_POAList.aspx">POA List</a></li>
                            <li><a href="i_POAUpload.aspx">POA Upload</a></li>
                            <li><a href="pageAddIntervention.aspx">Add Intervention</a></li>
                            <li><a href="i_QuarterlyTargets.aspx">Quarterly Targets</a></li>
                            <li><a href="ii_AssignIndicatorOwners.aspx">Assign Indicator Owners</a></li>
                        </ul>
                    </li>

                    <%-- Administrator: Dept/Entity Capturer dropdown --%>
                    <li class="dropdown" id="ddl_CapturerUnit" runat="server" visible="false">
                        <a id="A4" runat="server" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Dept/Entity <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li><a href="i_QuarterlyTargets.aspx">Quarterly Targets</a></li>
                            <li><a href="ii_DeptQuarterlyTargetsUpload.aspx">Upload Q Targets</a></li>
                            <li><a href="i_MyTasks.aspx">My Tasks</a></li>
                            <li><a href="i_ReportSubmit.aspx">Report Submit</a></li>
                            <li><a href="i_MySubmissions.aspx">My Submissions</a></li>
                            <li><a href="ii_ChangeRequests.aspx">My Change Requests</a></li>
                        </ul>
                    </li>

                    <%-- Administrator: HOD/CEO dropdown --%>
                    <li class="dropdown" id="ddl_HOD_CEO" runat="server" visible="false">
                        <a id="A5" runat="server" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">HOD/CEO <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li><a href="ii_ApprovalInbox.aspx">Approval Inbox</a></li>
                            <li><a href="i_Approval.aspx">Approve Reports</a></li>
                        </ul>
                    </li>

                    <%-- Administrator: Updates dropdown --%>
                    <li class="dropdown" id="updates1" runat="server" visible="false">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Updates <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li class="dropdown-header">Upload</li>
                            <li><a href="i_PMTDPUpload.aspx">PMTDP Upload</a></li>
                            <li><a href="i_POAUpload.aspx">POA Upload</a></li>
                            <li role="separator" class="divider"></li>
                            <li class="dropdown-header">Reference Data</li>
                            <li><a href="i_PriorityAdmin.aspx">Priority Focus</a></li>
                            <li><a href="i_ProgrammeAdmin.aspx">Integration Programme</a></li>
                            <li><a href="i_OutcomeAdmin.aspx">Impact (Outcomes)</a></li>
                            <li><a href="i_IndicatorAdmin.aspx">Indicators</a></li>
                            <li><a href="i_SystemPeriodsAdmin.aspx">System Periods</a></li>
                            <li role="separator" class="divider"></li>
                            <li class="dropdown-header">Reporting</li>
                            <li><a href="i_AnnualTargets.aspx">Annual Targets</a></li>
                            <li><a href="i_QuarterlyTargets.aspx">Quarterly Targets</a></li>
                            <li><a href="i_QuarterSummary.aspx">Quarter Summary</a></li>
                            <li><a href="i_ReportSubmit.aspx">Report Submit</a></li>
                            <li><a href="i_MySubmissions.aspx">My Submissions</a></li>
                            <li><a href="i_MyTasks.aspx">My Tasks</a></li>
                            <li><a href="i_Approval.aspx">Approval (HOD/CEO)</a></li>
                            <li><a href="i_QAInbox1.aspx">QA Inbox</a></li>
                            <li><a href="ii_AssignIndicatorOwners.aspx">Assign Indicator Owner</a></li>
                            <li><a href="ii_AssignIndicatorWorkingGroup.aspx">Assign Indicator WG</a></li>
                            <li><a href="ii_ChangeRequests.aspx">Manage CR</a></li>
                            <li><a href="i_MonitoringDashboard.aspx">Monitoring Dashboard</a></li>
                            <li><a href="i_NonCompliance.aspx">Non-Compliance Report</a></li>
                        </ul>
                    </li>

                    <%-- Planning Unit: Inbox --%>
                    <li id="ddl_PU_Inbox" runat="server" visible="false">
                        <a href="i_PU_Inbox.aspx"><i class="glyphicon glyphicon-inbox"></i> Inbox</a>
                    </li>

                    <%-- Planning Unit: Upload dropdown --%>
                    <li class="dropdown" id="ddl_PU_Upload" runat="server" visible="false">
                        <a id="A6" runat="server" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Upload <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li><a href="i_PMTDPUpload.aspx">PMTDP Upload</a></li>
                            <li><a href="j_PMTDPApprovalList.aspx">Approval List</a></li>
