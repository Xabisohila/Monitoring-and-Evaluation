                    <li class="dropdown" id="Departments_0" runat="server" visible="false">
                        <a id="A1" href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Departments <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li><a href="http://www.eccogta.gov.za/" target="_blank">CoGTa</a></li>
                            <li><a href="http://www.dedea.gov.za" target="_blank">DEDEA</a></li>
                            <li><a href="http://www.ecdoh.gov.za/" target="_blank">Health</a></li>
                            <li><a href="http://www.ecdpw.gov.za/" target="_blank">Public Works</a></li>
                            <li><a href="http://www.drdar.gov.za/" target="_blank">DRDAR</a></li>
                            <li><a href="http://www.safety.ecprov.gov.za/" target="_blank">Safety</a></li>
                            <li><a href="http://www.ecdsd.gov.za/Pages/home.aspx" target="_blank">Social Development</a></li>
                            <li><a href="http://www.ecsrac.gov.za/Pages/default.aspx" target="_blank">Sports</a></li>
                            <li><a href="http://www.ectransport.gov.za/" target="_blank">Transport</a></li>
                            <li><a href="http://www.ecprov.gov.za/" target="_blank">OTP</a></li>
                        </ul>
                    </li>

                    <li id="Calendar_0" runat="server" visible="false">
                        <a id="cont" href="ProvincialCalendar.aspx"><i class="glyphicon glyphicon-calendar"></i> Calendar</a>
                    </li>

                    <%-- User / sign-out dropdown (always visible) --%>
                    <li class="dropdown user-menu">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                            <i class="glyphicon glyphicon-user"></i>
                            <%= Session["FullName"] != null ? Server.HtmlEncode(Session["FullName"].ToString()) : "Account" %>
                            <span class="caret"></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-right">
                            <% if (Session["UserTypeD"] != null) { %>
                            <li class="dropdown-header"><%= Server.HtmlEncode(Session["UserTypeD"].ToString()) %></li>
                            <li role="separator" class="divider"></li>
                            <% } %>
                            <li><a href="login.aspx"><i class="glyphicon glyphicon-log-out"></i> Sign Out</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
