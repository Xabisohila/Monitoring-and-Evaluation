                            <li><a href="ii_AssignIndicatorOwners.aspx">Assign Indicator Owners</a></li>
                        </ul>
                    </li>

                    <%-- Dept/Entity: PlaceHolder fixes the invalid li-in-li nesting --%>
                    <asp:PlaceHolder ID="Dept_Entiry" runat="server" Visible="false">
                        <li><a href="i_MyTasks.aspx">My Tasks</a></li>
                        <li class="dropdown" id="Li2" runat="server">
                            <a id="A8" runat="server" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Reports <span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                <li><a href="i_ReportSubmit.aspx">Add New</a></li>
                                <li><a href="i_MySubmissions.aspx">View Submissions</a></li>
                            </ul>
                        </li>
                        <li class="dropdown" id="Li1" runat="server">
                            <a id="A7" runat="server" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Manage <span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                <li><a href="ii_DeptQuarterlyTargetsUpload.aspx">Upload Q Targets</a></li>
                                <li><a href="i_QuarterlyTargets.aspx">Update Existing Q Targets</a></li>
                            </ul>
                        </li>
                    </asp:PlaceHolder>

                    <%-- Other role-specific items --%>
                    <li id="ClusterWG_0" runat="server" visible="false"><a href="designedClusterWG.aspx">Cluster</a></li>

                    <li class="dropdown" id="ClusterWG_1" runat="server" visible="false">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Other <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li><a href="designPlanningOverview2.aspx">Planning Overview</a></li>
                            <li><a href="pageAddPOA.aspx">POA - Add New</a></li>
                            <li><a href="pageAddIntervention.aspx">Interv - Add New</a></li>
                            <li><a href="designedMonitoringOverview.aspx">Monitoring</a></li>
                            <li><a href="designedSubmitQuarterlyReport.aspx">Q Reports</a></li>
                            <li><a href="approvalIntervention.aspx">Pending Approvals</a></li>
                            <li><a href="ReviewMonitoring.aspx">Review Monitoring</a></li>
                        </ul>
                    </li>

                    <li class="dropdown" id="ClusterA1_li" runat="server" visible="false">
                        <a id="ClusterA1" runat="server" href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Admin <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li><a href="pageUserAdmin.aspx"><i class="glyphicon glyphicon-users"></i> Manage Users</a></li>
                            <li><a href="register.aspx">Register New User</a></li>
                            <li role="separator" class="divider"></li>
                            <li><a href="intervention_content.aspx">CMS</a></li>
                            <li><a href="upload.aspx">Uploads</a></li>
                        </ul>
                    </li>

                    <li id="Reports_0" runat="server" visible="false"><a href="ReportSummary.aspx">Report</a></li>

                    <li class="dropdown" id="DD_PlanningUnit" runat="server" visible="false">
                        <a id="A2" runat="server" href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">PU <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li><a href="register.aspx">Add New User</a></li>
                            <li><a href="pu_ClusterSetup.aspx">Cluster</a></li>
