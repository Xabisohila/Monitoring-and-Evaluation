    <%-- Page content --%>
    <div class="container-fluid">
        <asp:Panel ID="pnlWorkflow" runat="server" Visible="false">
            <uc:WorkflowStatus runat="server" ID="workflowPanel" />
        </asp:Panel>
        <asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </div>

    <footer id="fh5co-footer" style="border-top: 3px solid #038C13; padding: 40px 0 0;">
        <div class="container">
            <div class="row" style="padding-bottom: 32px;">

                <%-- Brand column --%>
                <div class="col-sm-4" style="margin-bottom: 24px;">
                    <div style="margin-bottom: 14px;">
                        <img src="img/OTPlogo.png" alt="OTP Logo" style="height: 52px;" />
                    </div>
                    <p style="font-size: 15px; font-weight: 600; color: #fff; margin: 0 0 6px;">Provincial M&amp;E System</p>
                    <p style="font-size: 12px; color: #878c93; line-height: 1.6; margin: 0;">
                        Monitoring &amp; Evaluation Planning Portal<br />
                        Office of the Premier &mdash; EC
                    </p>
                </div>

                <%-- Support links --%>
                <div class="col-sm-4" style="margin-bottom: 24px;">
                    <h3 class="fh5co-lead">Support</h3>
                    <ul>
                        <li><a href="#">Terms of Service</a></li>
                        <li><a href="#">M&amp;E Policy</a></li>
                        <li><a href="#">M&amp;E Steering Committee</a></li>
                        <li><a href="#">Contact Us</a></li>
                    </ul>
                </div>

                <%-- More links --%>
                <div class="col-sm-4" style="margin-bottom: 24px;">
                    <h3 class="fh5co-lead">More Links</h3>
                    <ul>
                        <li><a href="#">Feedback</a></li>
                        <li><a href="#">Frequently Asked Questions</a></li>
                        <li><a href="home.aspx">Home</a></li>
                        <li><a href="login.aspx">Sign Out</a></li>
                    </ul>
                </div>

            </div>
        </div>

        <%-- Copyright bar --%>
        <div style="border-top: 1px solid #1a1a1a; padding: 14px 0;">
            <div class="container">
                <div class="row">
                    <div class="col-sm-6">
                        <p class="fh5co-copyright" style="margin: 0;">
                            <small>&copy; <%= DateTime.Now.Year %> Office of the Premier. All Rights Reserved.</small>
                        </p>
                    </div>
                    <div class="col-sm-6 text-right">
                        <p class="fh5co-copyright" style="margin: 0;">
                            <small>Provincial M&amp;E Planning System</small>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="js/jquery.js" type="text/javascript"></script>
