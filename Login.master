<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Login.master.cs" Inherits="Login" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "">

<html xmlns="">
<head runat="server">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="dot net templates  | aspxtemplates.com">
    <meta name="author" content="aspxtemplates.com">
    <!-- Bootstrap Core CSS -->
    <title>MnE</title>
    <link href="css/bootstrap.min.css" rel="stylesheet">
    <!-- SmartMenus jQuery Bootstrap Addon CSS -->
    <link href="css/jquery.smartmenus.bootstrap.css" rel="stylesheet">
    <link href="css/owl/owl.carousel.css" rel="stylesheet" type="text/css" />
    <link href="css/owl/owl.theme.css" rel="stylesheet" type="text/css" />
    <link href="css/owl/owl.transitions.css" rel="stylesheet" type="text/css" />
    <!-- Custom CSS -->
    <link href="css/1-col-portfolio.css" rel="stylesheet">

    <link href="fonts/font-awesome.min.css" rel="stylesheet" type="text/css" />
    <style>
        .navbar-inverse.navbar-fixed-top { min-height: 58px; }
        .navbar-inverse .navbar-header { height: 58px; }
        .navbar-brand { padding-top: 5px; padding-bottom: 5px; height: 58px; }
    </style>
</head>
<body>
    <form id="form1" runat="server">
    <!-- Header Navbar fixed top -->
    <div class="navbar navbar-inverse navbar-fixed-top" role="navigation">
        <div class="container">
            <div class="navbar-header">
                <a href="login.aspx" class="navbar-brand" style="display:flex;align-items:center;padding-top:9px;padding-bottom:9px;">
                    <img class="logo" src="img/logo.png" alt="logo" style="height:48px;vertical-align:middle;" />
                    <span style="display:inline-block;margin-left:8px;vertical-align:middle;line-height:1.2;">
                        <strong style="display:block;font-size:14px;font-weight:700;color:#fff;">Provincial M&amp;E</strong>
                        <small style="display:block;font-size:10px;color:rgba(255,255,255,0.75);text-transform:uppercase;letter-spacing:0.5px;">Office of the Premier</small>
                    </span>
                </a>
            </div>
            <div class="navbar-collapse collapse">
                <!-- Left nav -->
            </div>
        </div>
    </div>
    <%--main Content--%>
    <div class="container-fluid">
        <asp:ContentPlaceHolder ID="head" runat="server">   
    </asp:ContentPlaceHolder>
        <asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server">
        
        </asp:ContentPlaceHolder>
    </div>
    <footer id="fh5co-footer" style="border-top: 3px solid #038C13; padding: 40px 0 0;">
        <div class="container">
            <div class="row" style="padding-bottom: 32px;">

                <div class="col-sm-4" style="margin-bottom: 24px;">
                    <div style="margin-bottom: 14px;">
                        <img src="img/OTPlogo.png" alt="OTP Logo" style="height: 52px;" />
                    </div>
                    <p style="font-size: 15px; font-weight: 600; color: #fff; margin: 0 0 6px;">Provincial M&amp;E System</p>
                    <p style="font-size: 12px; color: #878c93; line-height: 1.6; margin: 0;">
                        Monitoring &amp; Evaluation Planning Portal<br />
                        Office of the Premier &mdash; EC
                    </p>
                </div>

                <div class="col-sm-4" style="margin-bottom: 24px;">
                    <h3 class="fh5co-lead">Support</h3>
                    <ul>
                        <li><a href="#">Terms of Service</a></li>
                        <li><a href="#">M&amp;E Policy</a></li>
                        <li><a href="#">M&amp;E Steering Committee</a></li>
                        <li><a href="#">Contact Us</a></li>
                    </ul>
                </div>

                <div class="col-sm-4" style="margin-bottom: 24px;">
                    <h3 class="fh5co-lead">More Links</h3>
                    <ul>
                        <li><a href="#">Feedback</a></li>
                        <li><a href="#">Frequently Asked Questions</a></li>
                    </ul>
                </div>

            </div>
        </div>

        <div style="border-top: 1px solid #1a1a1a; padding: 14px 0;">
            <div class="container">
                <div class="row">
                    <div class="col-sm-6">
                        <p class="fh5co-copyright" style="margin: 0;">
                            <small>&copy; 2026 Office of the Premier. All Rights Reserved.</small>
                        </p>
                    </div>
                    <div class="col-sm-6 text-right">
                        <p class="fh5co-copyright" style="margin: 0;">
                            <small>Provincial M&amp;E Planning System</small>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <!-- jQuery -->
    <script src="js/jquery.js"></script>
    <!-- Bootstrap Core JavaScript -->
    <script src="js/bootstrap.min.js"></script>
    <script src="js/wow.min.js" type="text/javascript"></script>
